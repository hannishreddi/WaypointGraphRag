# Copy to .env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-min-8-chars

# LLM provider: gemini (free tier, default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
# MODEL_FAST: router and judge; MODEL_ANSWER: answers. Keep them different so the judge is not the answerer.
MODEL_FAST=gemini-3.5-flash-lite
MODEL_ANSWER=gemini-3.1-flash-lite
# Optional, with defaults
# LLM_RPM=5
# LLM_TIMEOUT_S=300
# GEMINI_THINKING_LEVEL=minimal

COHERE_API_KEY=your-cohere-api-key-here
COHERE_EMBED_MODEL=embed-v5.0-fast
EMBED_DIM=1024
